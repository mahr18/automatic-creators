# Local development only. Never commit real secrets.

BRAIN_ACCESS_TOKEN=replace-with-a-long-random-token
GEMINI_API_KEY=replace-with-your-gemini-api-key

# $0-first defaults
AI_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=7000
GEMINI_DAILY_CALL_GUARD=40

# Optional paid fallback — stays OFF
ENABLE_OPENAI_API=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH=false

# Optional — you said you can omit YouTube API for now.
YOUTUBE_API_KEY=

# Hard-off switch for metered video APIs
ENABLE_VIDEO_API=false
